@model ProjectDetailsViewModel
@{ ViewData["Title"] = Model.Project.Name; var project = Model.Project; }
<section class="page-intro project-detail-intro wrap"><a class="back-link" href="/projects">← All projects</a><p class="section-kicker">@project.Category · Project @project.Number</p><h1>@project.Name</h1><p>@project.Description</p><div class="tag-list">@foreach (var tech in project.Technologies) { <span>@tech</span> }</div><div class="hero-actions"><a class="button button-primary" href="@project.RepositoryUrl" target="_blank" rel="noopener noreferrer">View source code <span aria-hidden="true">↗</span></a>@if (project.DemoUrl is not null) { <a class="button button-secondary" href="@project.DemoUrl" target="_blank" rel="noopener noreferrer">Open live demo <span aria-hidden="true">↗</span></a> }</div></section>
<section class="section section-tinted"><div class="wrap detail-content"><article><p class="section-kicker">The problem</p><h2>What it set out to do</h2><p>@project.Problem</p></article><article><p class="section-kicker">The approach</p><h2>Designed around clear boundaries</h2><p>@project.Architecture</p></article><article><p class="section-kicker">What it includes</p><h2>Key features</h2><ul class="feature-list">@foreach (var feature in project.Features) { <li>@feature</li> }</ul></article><article><p class="section-kicker">What I learned</p><h2>Challenges and decisions</h2><p>@project.Challenges</p></article></div></section>
<nav class="wrap project-pagination" aria-label="Other projects">@if (Model.Previous is not null) { <a asp-action="Details" asp-route-slug="@Model.Previous.Slug">← @Model.Previous.Name</a> }@if (Model.Next is not null) { <a asp-action="Details" asp-route-slug="@Model.Next.Slug">@Model.Next.Name →</a> }</nav>
