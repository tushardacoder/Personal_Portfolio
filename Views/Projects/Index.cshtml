@model IReadOnlyList<Project>
@{ ViewData["Title"] = "Projects"; }
<section class="page-intro wrap"><p class="section-kicker">Selected work</p><h1>Projects that turn<br />ideas into software.</h1><p>A mix of backend systems and frontend experiences, each built to solve a clear problem or explore a new part of the stack.</p></section>
<section class="section wrap projects-page-list"><div class="project-list">@foreach (var project in Model) { <article class="project-row"><span class="project-number">@project.Number</span><div class="project-main"><p class="project-category">@project.Category</p><h2><a asp-action="Details" asp-route-slug="@project.Slug">@project.Name</a></h2><p>@project.Summary</p><div class="tag-list">@foreach (var tech in project.Technologies) { <span>@tech</span> }</div><div class="project-links"><a href="@project.RepositoryUrl" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>@if (project.DemoUrl is not null) { <a href="@project.DemoUrl" target="_blank" rel="noopener noreferrer">Live demo <span aria-hidden="true">↗</span></a> }</div></div><a class="row-arrow" asp-action="Details" asp-route-slug="@project.Slug" aria-label="View @project.Name details">↗</a></article> }</div></section>
